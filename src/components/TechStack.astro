<section class="tech-stack" id="tech">
  <div class="tech-stack__header">
    <span>Competenze</span>
    <span>Tech Stack</span>
  </div>

  <div class="tech-stack__groups">
    <article class="tech-group">
      <span class="tech-group__number">01</span>

      <div class="tech-group__content">
        <h2>BACKEND</h2>

        <p class="tech-group__skills">
          <span>Java</span>
          <span>Spring Boot</span>
          <span>PHP</span>
          <span>Python</span>
          <span>C++</span>
          <span>C</span>
        </p>
      </div>
    </article>

    <article class="tech-group">
      <span class="tech-group__number">02</span>

      <div class="tech-group__content">
        <h2>FRONTEND</h2>

        <p class="tech-group__skills">
          <span>Angular</span>
          <span>TypeScript</span>
          <span>JavaScript</span>
          <span>HTML</span>
          <span>CSS</span>
          <span>React Native</span>
          <span>Flutter</span>
        </p>
      </div>
    </article>

    <article class="tech-group">
      <span class="tech-group__number">03</span>

      <div class="tech-group__content">
        <h2>DATABASE</h2>

        <p class="tech-group__skills">
          <span>Oracle</span>
          <span>PostgreSQL</span>
          <span>MySQL</span>
          <span>SQL</span>
        </p>
      </div>
    </article>

    <article class="tech-group">
      <span class="tech-group__number">04</span>

      <div class="tech-group__content">
        <h2>TOOLS</h2>

        <p class="tech-group__skills">
          <span>Docker</span>
          <span>Jenkins</span>
          <span>Git</span>
          <span>GitLab</span>
          <span>Maven</span>
          <span>Gradle</span>
          <span>JUnit</span>
          <span>Postman</span>
          <span>Swagger</span>
          <span>Jira</span>
          <span>Linux</span>
          <span>JBoss</span>
          <span>WildFly</span>
        </p>
      </div>
    </article>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const canUseInteractiveMotion =
    window.matchMedia("(pointer: fine)").matches && !prefersReducedMotion;

  const techGroups = document.querySelectorAll(".tech-group");

  if (!prefersReducedMotion) {
    techGroups.forEach((group) => {
      const title = group.querySelector("h2");
      const text = group.querySelector("p");
      const number = group.querySelector(".tech-group__number");

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: group,
          start: "top 82%",
          toggleActions: "restart none restart none",
          invalidateOnRefresh: true,
        },
      });

      tl.fromTo(
        number,
        {
          opacity: 0,
          y: 20,
        },
        {
          opacity: 0.4,
          y: 0,
          duration: 0.5,
        },
      );

      tl.fromTo(
        title,
        {
          opacity: 0,
          y: 70,
        },
        {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: "power4.out",
        },
        "-=0.3",
      );

      tl.fromTo(
        text,
        {
          opacity: 0,
          y: 25,
        },
        {
          opacity: 0.65,
          y: 0,
          duration: 0.7,
          ease: "power3.out",
        },
        "-=0.5",
      );
    });
  }

  if (canUseInteractiveMotion) {
    const skillGroups = document.querySelectorAll<HTMLElement>(
      ".tech-group__skills",
    );

    skillGroups.forEach((group) => {
      const skills = group.querySelectorAll<HTMLElement>("span");

      skills.forEach((skill) => {
        skill.addEventListener("mouseenter", () => {
          group.classList.add("has-active-skill");

          skills.forEach((otherSkill) => {
            otherSkill.classList.toggle("is-active", otherSkill === skill);
          });

          gsap.to(skill, {
            y: -5,
            scale: 1.06,
            duration: 0.35,
            ease: "power3.out",
            overwrite: true,
          });
        });

        skill.addEventListener("mouseleave", () => {
          group.classList.remove("has-active-skill");

          skills.forEach((otherSkill) => {
            otherSkill.classList.remove("is-active");
          });

          gsap.to(skill, {
            y: 0,
            scale: 1,
            duration: 0.55,
            ease: "power3.out",
            overwrite: true,
          });
        });
      });
    });
  }
</script>

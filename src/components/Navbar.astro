<header class="navbar">
  <a class="logo" href="/">FS</a>

  <nav class="navbar__desktop" aria-label="Main navigation">
    <a href="#career">Career</a>
    <a href="#tech">Tech Stack</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
  </nav>

  <button
    class="navbar__menu-toggle"
    type="button"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span class="navbar__menu-icon" aria-hidden="true"></span>
  </button>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true" inert>
  <nav class="mobile-menu__nav" aria-label="Mobile navigation">
    <a href="#career">Career</a>
    <a href="#tech">Tech Stack</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
  </nav>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const toggle = document.querySelector<HTMLButtonElement>(
    ".navbar__menu-toggle",
  );

  const mobileMenu = document.querySelector<HTMLElement>(".mobile-menu");

  const mobileLinks = document.querySelectorAll<HTMLAnchorElement>(
    ".mobile-menu__nav a",
  );

  if (toggle && mobileMenu) {
    let isOpen = false;

    const openMenu = () => {
      if (isOpen) return;

      isOpen = true;

      gsap.killTweensOf(mobileMenu);
      gsap.killTweensOf(mobileLinks);

      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Close menu");

      mobileMenu.setAttribute("aria-hidden", "false");
      mobileMenu.inert = false;

      document.body.style.overflow = "hidden";

      if (prefersReducedMotion) {
        gsap.set(mobileMenu, {
          autoAlpha: 1,
        });

        gsap.set(mobileLinks, {
          y: 0,
          opacity: 1,
        });

        mobileLinks[0]?.focus();

        return;
      }

      gsap.to(mobileMenu, {
        autoAlpha: 1,
        duration: 0.45,
        ease: "power3.out",
      });

      gsap.fromTo(
        mobileLinks,
        {
          y: 50,
          opacity: 0,
        },
        {
          y: 0,
          opacity: 1,
          duration: 0.6,
          stagger: 0.08,
          ease: "power4.out",

          onComplete: () => {
            mobileLinks[0]?.focus();
          },
        },
      );
    };

    const closeMenu = (restoreFocus = true) => {
      if (!isOpen) return;

      isOpen = false;

      gsap.killTweensOf(mobileMenu);
      gsap.killTweensOf(mobileLinks);

      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open menu");

      document.body.style.overflow = "";

      const finishClose = () => {
        mobileMenu.setAttribute("aria-hidden", "true");
        mobileMenu.inert = true;

        if (restoreFocus) {
          toggle.focus();
        }
      };

      if (prefersReducedMotion) {
        gsap.set(mobileMenu, {
          autoAlpha: 0,
        });

        finishClose();

        return;
      }

      gsap.to(mobileMenu, {
        autoAlpha: 0,
        duration: 0.35,
        ease: "power3.inOut",
        onComplete: finishClose,
      });
    };

    toggle.addEventListener("click", () => {
      isOpen ? closeMenu() : openMenu();
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu(false);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen) {
        closeMenu();
      }
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 768 && isOpen) {
        closeMenu(false);
      }
    });
  }

  const desktopLinks =
    document.querySelectorAll<HTMLAnchorElement>(".navbar__desktop a");

  const mobileNavLinks = document.querySelectorAll<HTMLAnchorElement>(
    ".mobile-menu__nav a",
  );

  const setActiveLink = (href: string) => {
    desktopLinks.forEach((link) => {
      link.classList.toggle("is-active", link.getAttribute("href") === href);
    });

    mobileNavLinks.forEach((link) => {
      const isActive = link.getAttribute("href") === href;

      link.classList.toggle("is-active", isActive);

      if (isActive) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  };

  ["career", "tech", "about", "contact"].forEach((id) => {
    const section = document.querySelector<HTMLElement>(`#${id}`);

    if (!section) return;

    ScrollTrigger.create({
      trigger: section,
      start: "top 45%",
      end: "bottom 45%",
      invalidateOnRefresh: true,

      onEnter: () => setActiveLink(`#${id}`),
      onEnterBack: () => setActiveLink(`#${id}`),
    });
  });
</script>

<header class="navbar">
  <a class="logo" href="/">FS</a>

  <nav class="navbar__desktop">
    <a href="#career">Career</a>
    <a href="#tech">Tech Stack</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
  </nav>

  <button
    class="navbar__menu-toggle"
    type="button"
    aria-label="Open menu"
    aria-expanded="false"
  >
    Menu
  </button>
</header>

<div class="mobile-menu">
  <nav class="mobile-menu__nav">
    <a href="#career">Career</a>
    <a href="#tech">Tech Stack</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
  </nav>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const toggle = document.querySelector<HTMLButtonElement>(
    ".navbar__menu-toggle",
  );

  const mobileMenu = document.querySelector<HTMLElement>(".mobile-menu");

  const links = document.querySelectorAll<HTMLAnchorElement>(
    ".mobile-menu__nav a",
  );

  if (toggle && mobileMenu) {
    let isOpen = false;

    const openMenu = () => {
      isOpen = true;

      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Close menu");
      toggle.textContent = "Close";

      document.body.style.overflow = "hidden";

      gsap.to(mobileMenu, {
        autoAlpha: 1,
        duration: 0.45,
        ease: "power3.out",
      });

      gsap.fromTo(
        links,
        {
          y: 50,
          opacity: 0,
        },
        {
          y: 0,
          opacity: 1,
          duration: 0.6,
          stagger: 0.08,
          ease: "power4.out",
        },
      );
    };

    const closeMenu = () => {
      isOpen = false;

      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open menu");
      toggle.textContent = "Menu";

      document.body.style.overflow = "";

      gsap.to(mobileMenu, {
        autoAlpha: 0,
        duration: 0.35,
        ease: "power3.inOut",
      });
    };

    toggle.addEventListener("click", () => {
      isOpen ? closeMenu() : openMenu();
    });

    links.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen) {
        closeMenu();
      }
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 768 && isOpen) {
        closeMenu();
      }
    });
  }

  const desktopLinks =
    document.querySelectorAll<HTMLAnchorElement>(".navbar__desktop a");

  const setActiveLink = (href: string) => {
    desktopLinks.forEach((link) => {
      link.classList.toggle("is-active", link.getAttribute("href") === href);
    });
  };

  ["career", "tech", "about", "contact"].forEach((id) => {
    const section = document.querySelector<HTMLElement>(`#${id}`);

    if (!section) return;

    ScrollTrigger.create({
      trigger: section,
      start: "top 45%",
      end: "bottom 45%",

      onEnter: () => setActiveLink(`#${id}`),
      onEnterBack: () => setActiveLink(`#${id}`),
    });
  });
</script>

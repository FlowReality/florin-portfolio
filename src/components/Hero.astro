<section class="hero">
  <div class="hero__top js-hero-meta">
    <span>Software Engineer</span>
    <span>Based in Italy</span>
  </div>

  <div class="hero__content">
    <h1 class="hero__title">
      <span class="hero__line">
        <span class="hero__word js-hero-word js-code-hover">FLORIN</span>
      </span>

      <span class="hero__line hero__line--right">
        <span class="hero__word js-hero-word js-code-hover">SANDU</span>
      </span>
    </h1>

    <div class="hero__bottom js-hero-meta">
      <p>Creo applicazioni scalabili ed esperienze digitali moderne.</p>

      <span class="hero__stack"> Java / Spring / Angular / TypeScript </span>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initHeroAnimation = () => {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const words = document.querySelectorAll(".js-hero-word");
    const meta = document.querySelectorAll(".js-hero-meta");
    const navbar = document.querySelector(".navbar");

    if (prefersReducedMotion) {
      gsap.set(words, {
        opacity: 1,
        yPercent: 0,
        rotateX: 0,
        skewY: 0,
        filter: "blur(0px)",
      });

      gsap.set(meta, {
        opacity: 1,
        y: 0,
      });

      if (navbar) {
        gsap.set(navbar, {
          opacity: 1,
          y: 0,
        });
      }

      return;
    }

    const tl = gsap.timeline({
      defaults: {
        ease: "power4.out",
      },

      scrollTrigger: {
        trigger: ".hero",
        start: "top 80%",
        toggleActions: "restart none restart none",
        invalidateOnRefresh: true,
      },
    });

    tl.fromTo(
      words,
      {
        yPercent: 120,
        rotateX: 12,
        skewY: 5,
        filter: "blur(10px)",
        opacity: 0,
      },
      {
        yPercent: 0,
        rotateX: 0,
        skewY: 0,
        filter: "blur(0px)",
        opacity: 1,
        duration: 1.5,
        stagger: 0.14,
      },
    );

    tl.fromTo(
      meta,
      {
        opacity: 0,
        y: 30,
      },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0.1,
      },
      "-=0.65",
    );

    if (navbar) {
      tl.fromTo(
        navbar,
        {
          opacity: 0,
          y: -25,
        },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
        },
        "-=0.55",
      );
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroAnimation);
  } else {
    initHeroAnimation();
  }
</script>

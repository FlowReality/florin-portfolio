<section class="hero">

  <div class="hero__top js-hero-meta">
    <span>Software Engineer</span>
    <span>Based in Italy</span>
  </div>

  <div class="hero__content">

    <h1 class="hero__title">

      <span class="hero__line">
        <span class="hero__word js-hero-word">FLORIN</span>
      </span>

      <span class="hero__line hero__line--right">
        <span class="hero__word js-hero-word">SANDU</span>
      </span>

    </h1>

    <div class="hero__bottom js-hero-meta">

      <p>
        Building scalable applications and modern digital experiences.
      </p>

      <span class="hero__stack">
        Java / Spring / Angular / TypeScript
      </span>

    </div>

  </div>

</section>

<script>
  import gsap from "gsap";

  const initHeroAnimation = () => {
    const words = document.querySelectorAll(".js-hero-word");
    const meta = document.querySelectorAll(".js-hero-meta");
    const navbar = document.querySelector(".navbar");

    const tl = gsap.timeline({
      defaults: {
        ease: "power4.out",
      },
    });

    tl.fromTo(
      words,
      {
        yPercent: 120,
      },
      {
        yPercent: 0,
        duration: 1.4,
        stagger: 0.15,
      }
    );

    tl.fromTo(
      meta,
      {
        opacity: 0,
        y: 25,
      },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0.12,
      },
      "-=0.7"
    );

    if (navbar) {
      tl.fromTo(
        navbar,
        {
          opacity: 0,
          y: -20,
        },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
        },
        "-=0.8"
      );
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroAnimation);
  } else {
    initHeroAnimation();
  }
</script>

---
// Keep the source in color; grayscale is applied in CSS.
const portrait = "/images/florin-portrait.jpeg";
---

<figure class="about-portrait">
  <img src={portrait} alt="Ritratto di Florin Sandu" width="400" height="400" loading="lazy" decoding="async" />
  <canvas class="about-portrait__mercury" aria-hidden="true"></canvas>
</figure>

<style>
  .about-portrait {
    position: relative;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #171717;
    isolation: isolate;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .about-portrait.is-mercury { cursor: none; }

  @media (max-width: 768px) {
    .about-portrait { max-width: 100%; }
  }
</style>

<script>
  import "../scripts/aboutPortrait";
</script>

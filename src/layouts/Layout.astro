---
import "../styles/global.scss";

const { title = "Florin Sandu — Software Engineer" } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>

    <meta
      name="description"
      content="Portfolio di Florin Sandu, Software Engineer."
    />

    <meta name="author" content="Florin Sandu" />

    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Florin Sandu — Software Engineer" />
    <meta
      property="og:description"
      content="Portfolio di Florin Sandu, Software Engineer specializzato in Java, Spring Boot, Angular e applicazioni web enterprise."
    />
    <meta property="og:image" content="/og-image.png" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Florin Sandu — Software Engineer" />
    <meta
      name="twitter:description"
      content="Portfolio di Florin Sandu, Software Engineer specializzato in Java, Spring Boot, Angular e applicazioni web enterprise."
    />
    <meta name="twitter:image" content="/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="cursor" aria-hidden="true">
      <div class="cursor__code">
        <span>{}</span>
        <span>&lt;/&gt;</span>
        <span>01</span>
        <span>λ</span>
        <span>[]</span>
        <span>::</span>
        <span>#</span>
        <span>&lt;/&gt;</span>
      </div>
      <div class="cursor__label">MAIL ↗</div>
    </div>
    <canvas class="cursor-trail-canvas" aria-hidden="true"></canvas>
    <slot />
    <script>
      import "../scripts/smoothScroll";
      import "../scripts/cursor";
    </script>
  </body>
</html>
